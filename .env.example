# ==============================================================================
# Django Configuration & Infrastructure Environment Template (.env.example)
# ==============================================================================

# Core Django Settings
SECRET_KEY=your-super-secret-production-key-here
DEBUG=False
DJANGO_ENV=production
DOMAIN=localhost

# Security & Origin Access Control (Comma-separated values)
ALLOWED_HOSTS=localhost,127.0.0.1,django-app
CORS_ALLOWED_ORIGINS=https://localhost:8080,https://localhost:3000
CSRF_TRUSTED_ORIGINS=https://localhost:8080,https://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-db-password-here
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Redis Cache & Broker Configuration
REDIS_PASSWORD=your-secure-redis-password-here

# 12-Factor App Database Connection String (Optional, overrides individual DB fields)
DATABASE_URL=postgres://postgres:your-secure-db-password-here@database:5432/postgres
